# 复制为 application.yml 后填入真实值

spring:
  application:
    name: alanapi-backend
  datasource:
    driver-class-name: com.mysql.cj.jdbc.Driver
    url: jdbc:mysql://<数据库地址>:3306/<库名>
    username: <数据库用户名>
    password: <数据库密码>
  mvc:
    pathmatch:
      matching-strategy: ANT_PATH_MATCHER
  session:
    timeout: 86400
    store-type: redis
  redis:
    port: 6379
    host: <redis 地址>
    database: 0
    password: <redis 密码>
  servlet:
    multipart:
      max-file-size: 5MB
      max-request-size: 10MB

# 火山引擎 TOS 对象存储
tos:
  endpoint: tos-cn-shanghai.volces.com
  region: cn-shanghai
  access-key: <TOS AK>
  secret-key: <TOS SK>
  bucket-name: <桶名>
  # 自定义访问域名（可选）
  domain:

# 阿里云号码认证服务（融合认证-短信认证），用于手机号验证码登录
# 套餐包：融合认证解决方案-通信服务套餐包
alan:
  sms:
    access-key-id: <阿里云 RAM 用户 AK，需有 dypnsapi 调用权限>
    access-key-secret: <阿里云 AK Secret>
    sign-name: <短信签名名称（控制台赠送签名）>
    template-code: <短信模板 Code（与签名配套使用）>
  # 邮箱 SMTP（邮箱登录 / 重置密码验证码）
  # QQ 邮箱：smtp.qq.com:465；163 邮箱：smtp.163.com:465；授权码在邮箱设置里生成
  # 不配置 username/auth-code 时为开发模式：验证码不真正发送，打印到后端日志
  mail:
    host: smtp.qq.com
    port: 465
    username: <发件邮箱，如 xxx@qq.com>
    auth-code: <SMTP 授权码>
  # 开放接口调用凭证（发布接口前试调用验证用，为 user 表中注册用户的 accessKey / secretKey，不配置时无法发布接口）
  api:
    access-key: <user 表中注册用户的 accessKey>
    secret-key: <对应的 secretKey>
    host: http://localhost:8123/api

server:
  port: 7529
  servlet:
    context-path: /api

mybatis-plus:
  configuration:
    map-underscore-to-camel-case: false
    log-impl: org.apache.ibatis.logging.stdout.StdOutImpl
  global-config:
    db-config:
      logic-delete-field: isDelete
      logic-delete-value: 1
      logic-not-delete-value: 0
